---
import defaultCv from "../../../cv.json";
const cv = Astro.props.cv || defaultCv;
const lang = Astro.props.lang || "es";
const { basics } = cv;
import WorldMap from "../../icons/WorldMap.astro";
import GitHub from "../../icons/GitHub.astro";
import LinkedIn from "../../icons/LinkedIn.astro";
import Gmail from "../../icons/Mail.astro";
import Phone from "../../icons/Phone.astro";
import ThemeToggle from "../ThemeToggle.astro";

const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");

const linkedUrl = linkedInfo?.url;

const gitInfo = profiles.find(({ network }) => network === "GitHub");

const gitUrl = gitInfo?.url;

const xInfo = profiles.find(({ network }) => network === "X");

const xUrl = xInfo?.url;
---

<section style="position: relative;">
  <div class="lang-selector">
    <a href="/" class={`lang-btn ${lang === "es" ? "active" : ""}`}>ES</a>
    <a href="/en" class={`lang-btn ${lang === "en" ? "active" : ""}`}>EN</a>
    <ThemeToggle />
  </div>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <h2>{label}</h2>
      <p>
        {
          lang === "en"
            ? "If you can imagine it, you can code it"
            : "Si puedes imaginarlo, puedes programarlo"
        }
      </p>
      <span>
        <WorldMap />
        {city}, {region}
      </span>
      <footer class="print">
        <ul>
          <li><Phone /> {phone}</li>
          <li><Gmail /> {email}</li>
          <li>
            <a href={linkedUrl} target="_blank" title={`LinkedIn`}>
              <LinkedIn />
              {linkedInfo.username}
            </a>
          </li>
          <li>
            <a href={basics.cvPdf} download="Cv-Gino-Ciancia"
              >{lang === "en" ? "Download CV" : "Descargar CV"}</a
            >
          </li>
        </ul>
      </footer>
      <footer class="web">
        <ul>
          <li>
            <a href={linkedUrl} target="_blank" title={`LinkedIn`}>
              <LinkedIn />
            </a>
          </li>
          <li>
            <a
              href={`mailto:${email}?subjetct=subject text`}
              title={`${email}`}
            >
              <Gmail />
            </a>
          </li>
          <li>
            <button id="phone-button">
              <Phone />
            </button>
          </li>
          <li>
            <a href={gitUrl} target="_blank" title={`perfil de gitHub`}>
              <GitHub />
            </a>
          </li>
          <li>
            <a href={basics.cvPdf} download="Cv-Gino-Ciancia"
              >{lang === "en" ? "CV English" : "CV Español"}</a
            >
          </li>
        </ul>
      </footer>
    </div>
    <figure>
      <img src={image} alt=`${name} ${label}` />
    </figure>
  </div>
</section>

<script>
  const buttonPhone = document.getElementById("phone-button");
  if (buttonPhone) {
    buttonPhone.addEventListener("click", () => {
      window.location.href = "tel:+54 1140230671";
    });
  } else {
    console.error('No se encontró el botón con el ID "phone-button"');
  }
</script>

<style>
  .lang-selector {
    position: absolute;
    right: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-btn {
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    font-size: 0.8em;
    color: var(--text-muted);
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .lang-btn:hover {
    background-color: var(--bg-hover);
    border-color: var(--border);
    color: var(--text);
  }

  .lang-btn.active {
    background-color: var(--surface);
    color: var(--text);
    font-weight: bold;
  }

  .container {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .info > p {
    font-style: italic;
    font-weight: normal;
    font-size: small;
  }

  span {
    color: var(--text-muted);
    margin-top: 20px;
  }

  .web > ul,
  .print > ul {
    display: flex;
    gap: 0.8em;
  }

  .print > ul > li {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding: 5px 10px;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }

  .print > ul > li a {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }

  .web > ul > li {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    transition:
      background-color ease-in 0.1s,
      border-color ease-in 0.1s;
    cursor: pointer;
  }

  .web > ul > li:hover {
    background-color: var(--bg-hover);
    border-color: var(--border);
  }

  button {
    border: none;
    background-color: transparent;
    cursor: pointer;
  }
  .web > ul > li > a,
  button {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: auto;
    color: var(--text-muted);
    padding: 10px;
    transition: color ease-in 0.1s;
  }

  .web > ul > li:hover > a,
  .web > ul > li:hover > button {
    color: var(--text);
  }

  .web,
  .print {
    margin-top: 20px;
  }

  .print {
    display: none;
  }

  figure > img {
    border-radius: 20px;
    height: 160px;
    width: 160px;
    object-fit: cover;
  }

  @media (width <= 700px) {
    .lang-selector {
      top: -35px;
      right: 50%;
      transform: translateX(50%);
    }

    .container {
      flex-direction: column-reverse;
      gap: 1.5em;
    }

    .info {
      justify-content: center;
      align-items: center;
    }

    h2 {
      text-align: center;
    }

    span {
      font-size: 0.8em;
    }

    .info > p {
      text-align: center;
    }
  }

  @media print {
    .web {
      display: none;
    }

    .print {
      display: block;
    }

    span {
      font-size: 0.8em;
    }

    figure > img {
      height: 130px;
      width: 130px;
    }

    .print > ul > li {
      font-size: 0.75em;
    }
  }
</style>
