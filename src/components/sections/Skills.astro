---
import defaultCv from "../../../cv.json";
import GitHub from "../../icons/GitHub.astro";
import React from "../../icons/react.astro";
import HTML from "../../icons/html.astro";
import CSS from "../../icons/css.astro";
import Git from "../../icons/git.astro";
import Node from "../../icons/node.astro";
import SQL from "../../icons/sql.astro";
import MySQL from "../../icons/mysql.astro";
import Javascript from "../../icons/javascript.astro";
import AstroIcon from "../../icons/Astro.astro";
import MongoDB from "../../icons/MongoDB.astro";
import Express from "../../icons/Express.astro";
import Tailwind from "../../icons/tailwind.astro";
import N8n from "../../icons/N8n.astro";
import Supabase from "../../icons/Supabase.astro";
import TypeScript from "../../icons/typescript.astro";
import Postman from "../../icons/Postman.astro";
import DockerIcon from "../../icons/DockerIcon.astro";
import MercadoPago from "../../icons/MercadoPago.astro";
import Google from "../../icons/Google.astro";
import Telegram from "../../icons/Telegram.astro";
import Webhooks from "../../icons/Webhooks.astro";
import Rag from "../../icons/Rag.astro";
import OCR from "../../icons/OCR.astro";
import OpenAI from "../../icons/OpenAi.astro";
import Vercel from '../../icons/Vercel.astro'
import Render from "../../icons/Render.astro";
import Playwright from "../../icons/Playwritht.astro";
import Prisma from "../../icons/Prisma.astro";
import Vitest from "../../icons/Vitest.astro";
import JWT from "../../icons/JWT.astro";
import Zod from "../../icons/Zod.astro";
import Redis from "../../icons/Redis.astro";
import K6 from "../../icons/K6.astro";
import PostgreSQL from "../../icons/PostgreSQL.astro"

type IconComponent = typeof HTML;

interface Skill {
  name: string;
  level?: string;
}

interface Props {
  cv?: { skills: Skill[]; learning?: Skill[] };
  lang?: string;
}

const cv = Astro.props.cv || defaultCv;
const lang = Astro.props.lang || "es";
const { skills, learning } = cv;

const SKILLS_ICONS: Record<string, IconComponent> = {
  HTML,
  CSS,
  Javascript,
  TypeScript,
  React,
  Node,
  "Node.js": Node,
  SQL,
  MySQL,
  Git,
  GitHub,
  Astro: AstroIcon,
  MongoDB,
  Express,
  Tailwind,
  "Tailwind CSS": Tailwind,
  N8n,
  Supabase,
  Docker: DockerIcon,
  Postman,
  "Mercado Pago SDK": MercadoPago,
  "Google Sheets API": Google,
  "Telegram API": Telegram,
  Webhooks,
  RAG: Rag,
  OCR,
  "OpenAI API": OpenAI,
  JWT,
  Zod,
  Vercel,
  Render,
  Prisma,
  Vitest,
  Playwright,
  Redis,
  "k6":K6,
  PostgreSQL
};

const renderSkillItem = (name: string, level?: string) => {
  const iconName: string = name === "JavaScript" ? "Javascript" : name;
  const Icon: IconComponent | undefined = SKILLS_ICONS[iconName];
  return { Icon, name, level };
};
---

<section>
  <h3>{lang === "en" ? "Skills" : "Habilidades"}</h3>
  <ul>
    {
      skills.map((skill: Skill) => {
        const { Icon, name } = renderSkillItem(skill.name, skill.level);
        return (
          <li>
            {Icon && <Icon />} <span>{name}</span>
          </li>
        );
      })
    }
  </ul>
  {learning && learning.length > 0 && (
    <div class="learning">
      <h4>{lang === "en" ? "Learning" : "Aprendiendo"}</h4>
      <ul>
        {
          learning.map((skill: Skill) => {
            const { Icon, name } = renderSkillItem(skill.name, skill.level);
            return (
              <li>
                {Icon && <Icon />} <span>{name}</span>
              </li>
            );
          })
        }
      </ul>
    </div>
  )}
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  ul {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1em;
  }

  .learning {
    margin-top: 0.5em;
  }

  h4 {
    font-size: 0.9em;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    margin-bottom: 0.4em;
  }

  .learning li {
    font-size: 0.95em;
    background-color: transparent;
    border: 1px dashed rgba(0, 0, 0, 0.2);
    opacity: 0.75;
  }

  .learning li:hover {
    opacity: 0.55;
  }

  li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.2em;
    font-size: 1.1em;
    font-weight: 500;
    padding: 5px 10px;
    background-color: #0000000e;
    border-radius: 10px;
    transition: opacity 0.2s;
    cursor: pointer;
  }

  .level {
    position: absolute;
    top: -10px;
    right: -20px;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 5px;
    border-radius: 5px;
    color: white;
    opacity: 0;
    transition: opacity 0.2s;
  }

  li:hover .level {
    opacity: 1;
  }

  li:hover {
    opacity: 0.5;
  }

  @media (width <= 700px) {
    li {
      font-size: 0.8em;
    }
  }

  @media print {
    ul {
      gap: 0.8em;
    }

    li {
      font-size: 0.8em;
    }
  }
</style>
