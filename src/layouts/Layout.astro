---
interface Props {
  title: string;
  lang?: string;
}

const { title, lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/pofolio.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  @view-transition {
    navigation: auto;
  }

  /* Paleta clara */
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --bg-panel: #fafafa;
    --bg-element: #f5f5f5;
    --bg-hover: #ebebeb;
    --surface: rgba(0, 0, 0, 0.05);
    --text: #1a1a1a;
    --text-strong: #000000;
    --text-muted: #8a8a8a;
    --text-soft: rgba(0, 0, 0, 0.7);
    --border: #b8b8b8;
    --border-subtle: rgba(0, 0, 0, 0.08);
    --accent: #3b7dd8;
    --accent-hover: #2968c3;
    --success: #3d9a57;
    --tooltip-bg: rgba(0, 0, 0, 0.8);
    --tooltip-text: #ffffff;
    --shadow: rgba(0, 0, 0, 0.15);
  }

  /* Paleta oscura basada en el tema por defecto de OpenCode */
  html[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0a0a0a;
    --bg-panel: #141414;
    --bg-element: #1e1e1e;
    --bg-hover: #282828;
    --surface: rgba(255, 255, 255, 0.06);
    --text: #eeeeee;
    --text-strong: #ffffff;
    --text-muted: #808080;
    --text-soft: #b5b5b5;
    --border: #484848;
    --border-subtle: #3c3c3c;
    --accent: #fab283;
    --accent-hover: #ffc09f;
    --success: #7fd88f;
    --tooltip-bg: #282828;
    --tooltip-text: #eeeeee;
    --shadow: rgba(0, 0, 0, 0.6);
  }

  html {
    background-color: var(--bg);
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    text-decoration: none;
    list-style: none;
    font-family: "Roboto", sans-serif;
    font-weight: 300;
    font-style: normal;
    text-wrap: pretty;
  }

  h1 {
    font-size: 2.8em;
    font-family:
      "Roboto", Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue",
      sans-serif;
  }

  h2 {
    width: 75%;
    font-size: 1.3em;
    font-weight: 400;
  }

  p,
  time {
    font-family: "Source Code Pro", sans-serif;
    font-weight: 350;
    line-height: 1.7;
    font-size: 1.1em;
    letter-spacing: 0.5;
  }

  p {
    color: var(--text-soft);
  }

  h3 {
    font-size: 1.7em;
    font-weight: bold;
    margin-bottom: 0.5em;
  }

  a {
    color: var(--text);
  }

  @media (width <= 700px) {
    h1 {
      font-size: 1.7em;
    }

    h2 {
      font-size: 1em;
    }

    h3 {
      font-size: 1.5em;
    }

    p,
    time {
      font-size: 0.75em;
    }
  }

  @media print {
    :root,
    html[data-theme="dark"] {
      color-scheme: light;
      --bg: #ffffff;
      --bg-panel: #ffffff;
      --bg-element: #f5f5f5;
      --bg-hover: #ebebeb;
      --surface: rgba(0, 0, 0, 0.05);
      --text: #1a1a1a;
      --text-strong: #000000;
      --text-muted: #8a8a8a;
      --text-soft: rgba(0, 0, 0, 0.7);
      --border: #b8b8b8;
      --border-subtle: rgba(0, 0, 0, 0.08);
      --accent: #3b7dd8;
      --accent-hover: #2968c3;
      --success: #3d9a57;
      --tooltip-bg: rgba(0, 0, 0, 0.8);
      --tooltip-text: #ffffff;
      --shadow: rgba(0, 0, 0, 0.15);
    }

    body {
      transition: none;
    }

    h1 {
      font-size: 1.9em;
    }

    h2 {
      font-size: 0.9em;
    }

    h3 {
      font-size: 1.2em;
    }

    p,
    time {
      font-size: 0.8em;
    }
  }
</style>
